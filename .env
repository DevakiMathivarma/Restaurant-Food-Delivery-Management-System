# database - using sqlite for simplicity, no separate server needed
DATABASE_URL=sqlite:///./food_delivery_platform.db

# jwt - real access + refresh tokens
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# redis - used for caching (restaurant) AND as celery's broker/backend
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# celery - separate redis db numbers from the cache above, so celery's
# own bookkeeping never mixes with cached data
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# smtp - used for all notification emails, sent through celery tasks
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mathivarmaganesan@gmail.com
SMTP_PASSWORD=pigp fuft gdqf jkaa
SMTP_FROM_EMAIL=mathivarmaganesan@gmail.com

# default admin, created automatically on first startup
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_PHONE=9999999999

# rate limiting - used on /auth/register and /auth/login
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# google maps - bonus feature (address geocoding, restaurant delivery
# distance). needs a REAL key from your own google cloud account to
# actually work - without one, address creation still succeeds, it just
# won't have real coordinates filled in. get a key at:
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=